{
  "productName": "LLM Privacy Gateway",
  "version": "0.1.0",
  "identifier": "com.vickylast.llmprivacygateway",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LLM Privacy Gateway",
        "width": 1080,
        "height": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline';"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "vickylast",
    "targets": "nsis",
    "category": "Utility",
    "shortDescription": "Local privacy filtering for OpenAI- and Anthropic-compatible API clients.",
    "longDescription": "Routes supported LLM API requests through a loopback-only gateway that detects, blocks, masks, or pseudonymizes sensitive information before forwarding.",
    "licenseFile": "../../../LICENSE",
    "icon": ["icons/icon.ico"],
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "SimpChinese"]
      }
    }
  }
}
