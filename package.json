{
  "name": "llm-privacy-gateway",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/VickylastShao/llm-privacy-gateway.git"
  },
  "homepage": "https://github.com/VickylastShao/llm-privacy-gateway#readme",
  "bugs": {
    "url": "https://github.com/VickylastShao/llm-privacy-gateway/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run && npm run test:sdk && npm run test:release",
    "test:sdk": "node --test tests/compatibility/node/*.test.mjs",
    "test:release": "node --test tests/release/*.test.mjs",
    "lint": "tsc --noEmit",
    "check:versions": "node scripts/check-versions.mjs",
    "check:release": "node scripts/check-release-readiness.mjs",
    "smoke:provider": "node scripts/real-provider-smoke.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.111.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "jsdom": "^29.1.1",
    "openai": "6.46.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
